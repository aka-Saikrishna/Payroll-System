# ---------------------------------------------------------------------------
# DATABASE
# ---------------------------------------------------------------------------
# DATABASE_URL  = pooled connection, used by the app at runtime.
# DIRECT_URL    = direct/unpooled connection, used by `prisma migrate`.
#
# Local development (Docker Postgres) — both point at the same database:
DATABASE_URL="postgresql://veekay:veekay_dev_password@localhost:5433/veekay_payroll?schema=public"
DIRECT_URL="postgresql://veekay:veekay_dev_password@localhost:5433/veekay_payroll?schema=public"
#
# Production on Neon — copy BOTH strings from the Neon dashboard. The pooled
# one contains "-pooler" in the host. Append the pgbouncer flags to it:
# DATABASE_URL="postgresql://USER:PASS@ep-xxx-pooler.REGION.aws.neon.tech/veekay_payroll?sslmode=require&pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://USER:PASS@ep-xxx.REGION.aws.neon.tech/veekay_payroll?sslmode=require"

# ---------------------------------------------------------------------------
# AUTH
# ---------------------------------------------------------------------------
# Generate a real secret before deploying:  openssl rand -base64 48
JWT_SECRET="change-this-to-a-long-random-secret"
JWT_EXPIRES_IN="8h"

NODE_ENV="development"
